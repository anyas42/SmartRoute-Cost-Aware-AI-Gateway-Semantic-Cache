# ==============================================================================
# SmartRoute: Semantic Caching and Cost-Aware LLM Routing Configuration
# ==============================================================================

# Server Environment
APP_NAME="SmartRoute AI Gateway"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider Configuration
# Set to 'mock' for offline simulated demo (zero cost, no API key needed)
# Set to 'openai' for live LLM providers (OpenAI, Groq, DeepSeek, Local Ollama)
LLM_PROVIDER=mock

# Live API Credentials (Only needed if LLM_PROVIDER=openai)
# NEVER commit your actual API keys to version control!
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
REQUEST_TIMEOUT_SECONDS=30.0

# Configurable Model Tiers
# Tier 1 (Small): Economy model for factual Q&A, lookups, and short queries
SMALL_MODEL_NAME=gpt-4o-mini

# Tier 2 (Large): Flagship reasoning model for complex architecture, logic, and code
LARGE_MODEL_NAME=gpt-4o

# Semantic Caching Configuration
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_TTL_SECONDS=86400
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MAX_CACHE_ENTRIES=10000

# Cost-Aware Routing Configuration
# Options: 'rule_based' (deterministic rules) or 'classifier' (feature scoring)
DEFAULT_ROUTING_STRATEGY=rule_based
COMPLEXITY_TOKEN_THRESHOLD=60
CLASSIFIER_THRESHOLD=0.50

# Database Persistence
DATABASE_PATH=smartroute.db

# Request Safeguards
MAX_QUERY_LENGTH=4000
ENABLE_NEGATION_DETECTION=true
